  "findings": [
    {
      "part": "caudal_lower_lobe",
      "result": "needs_repair",
      "observation": "当前灰模下尾叶狭窄、尖直，后缘到尾叉呈直线式折转。FAO同种图谱下叶根部更饱满、后缘更有弧度。本地游戏原网格也较饱满，但材质alpha未还原，仅辅助。",
      "constraint": "保留异尾上下不等长，恢复下叶面积和连续弧线；不能直接把尾尖磨圆或整体等比放大。"
    },
    {
      "part": "caudal_upper_lobe",
      "result": "needs_repair",
      "observation": "当前上叶内缘长而直，尖前凹口呈短硬折，端叶过薄。FAO图谱可辨凹口和其后的端叶。凹口本身是结构，不应当锯齿全部抹掉。",
      "constraint": "按尾柄、上叶根、凹口、端叶四处分别确定连续轮廓；保留凹口。"
    },
    {
      "part": "peduncle_transition",
      "result": "needs_review",
      "observation": "当前俯视与侧视尾根可见接环/折阶，库模型更连续。灰模显示应继续核对截面和法线，不能仅根据接缝阴影断言物理裂缝。",
      "constraint": "修尾时联合尾柄末段与鳍根，不做独立尾片硬接；完整根带与动作复验。"
    },
    {
      "part": "body_head",
      "result": "not_verified",
      "observation": "当前侧视中腹饱满、腹线鼓起，库模型也有腹部体积；相对FAO图谱我们的背腹轮廓更凸。俯视保有短宽圆吻，不能笼统判整头错误。实拍存在转身透视，体高体宽准确偏差未知。",
      "constraint": "同种实拍和图谱指导裸身体吻/鳃/腹/尾柄站点复核，不按库模型整体压瘦或改头。"
    },
    {
      "part": "source_chain",
      "result": "confirmed",
      "observation": "当前正式模型、新意向图及早期040原画尾轮廓都有相似倾向；当前下叶比原画更窄尖。新意向继承几何问题，单换材质不足以解决。",
      "constraint": "当前黑鳍意向暂停烘焙，形态校正先行。"
    }
  ],
